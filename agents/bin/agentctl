#!/usr/bin/env python3
"""agentctl - per-space chief-of-staff agents on herdr.

  agentctl watch                      daemon: start a CoS in every newly created herdr workspace
  agentctl start-cos [WORKSPACE_ID]   start a CoS in a workspace (default: the current one)
  agentctl spawn ROLE SLUG --title T --task T   (ROLE: lead|worker|reviewer|researcher)
                                      (CoS/leads) start an agent: leads get a tab labeled TITLE;
                                      workers/reviewers split into their lead's tab
  agentctl report TEXT                (any child) send TEXT to the parent agent's pane
  agentctl needs-you TEXT             (CoS) alert the user that a decision is waiting
  agentctl adopt PANE SLUG --title T  make a hand-started claude/codex pane a lead of the space's CoS
  agentctl farm [--port 8787]         serve the live farm view in a browser
  agentctl specialties                list specialist animals (~/agents/specialties/<name>.md)
  agentctl ask --lead L --question Q --rec R --default D [-p P1]   (lead farmer) record a decision
  agentctl resolve D3 --answer "..."  (lead farmer) close a decision
  agentctl decisions                  open decisions (the "Needs you" block)
  agentctl ls                         agents in this space

Roles: lead, worker, reviewer, researcher (role prompts in ~/agents/roles/).
Reviewers and researchers are read-only: they may only write their own output directory.
"""
import argparse
import json
import os
import random
import select
import re
import socket
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
AGENTS = os.path.join(HOME, "agents")
ROLES = os.path.join(AGENTS, "roles")
SPACES = os.path.join(AGENTS, "spaces")
SETTINGS = os.path.join(AGENTS, "settings.json")
# Claude Code's auto-memory dir for $HOME (e.g. ~/.claude/projects/-home-alice/memory); optional.
MEMDIR = os.path.join(HOME, ".claude", "projects", HOME.replace("/", "-"), "memory")
CONTEXT = os.path.join(AGENTS, "context.md")  # personal, not in git: who the user is, repo rules
BUILD = os.path.join(AGENTS, ".build")
INBOX = os.path.join(AGENTS, "inbox")  # one JSONL queue per recipient agent
SOCK = os.environ.get("HERDR_SOCKET_PATH", os.path.join(HOME, ".config", "herdr", "herdr.sock"))
SELF = os.path.abspath(__file__)
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
PANES_PER_TAB = 4
COS_LABEL = "lead farmer"          # the chief of staff, farm flavored
COS_PREFIX = "leadfarmer-"         # agent name prefix for new lead farmers
ANIMALS = {"worker": "horse", "researcher": "dog", "reviewer": "goose"}  # animal per child role
SPECIES = ["cow", "pig", "sheep", "goat", "chicken", "duck", "rabbit", "donkey", "llama", "bee", "turkey", "cat"]
SPECIALTIES = os.path.join(os.path.expanduser("~"), "agents", "specialties")  # user/agent-defined, local


def load_specialty(name):
    """~/agents/specialties/<name>.md: optional '---' header (role:, animal:, description:) + body."""
    path = os.path.join(SPECIALTIES, f"{name}.md")
    if not os.path.exists(path):
        return None
    text = open(path).read()
    meta, body = {}, text
    if text.startswith("---"):
        head, _, body = text[3:].partition("\n---")
        for line in head.splitlines():
            k, _, v = line.partition(":")
            if k.strip():
                meta[k.strip().lower()] = v.strip()
    return {"name": name, "meta": meta, "body": body.strip(), "path": path}


def animal_for(role, specialty=None):
    """Children are animals: a specialty gets its declared species, or a stable one from its name."""
    if role not in ANIMALS:
        return None
    if specialty:
        spec = load_specialty(specialty) or {"meta": {}}
        want = spec["meta"].get("animal", "").lower()
        if want:
            return want
        return SPECIES[sum(map(ord, specialty)) % len(SPECIES)]
    return ANIMALS[role]


def cos_name(wid):
    """The lead farmer of a space: whatever space.json recorded (older spaces use cos-<wid>)."""
    try:
        name = json.load(open(os.path.join(SPACES, wid, "space.json"))).get("cos")
        if name:
            return name
    except (OSError, ValueError):
        pass
    return f"{COS_PREFIX}{wid.lower()}"
TITLE_MAX = 40


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, file=sys.stderr, flush=True)


def herdr(*args, check=True):
    env = dict(os.environ, HERDR_SOCKET_PATH=SOCK)
    p = subprocess.run(["herdr", *args], capture_output=True, text=True, env=env)
    out = p.stdout.strip() or p.stderr.strip()
    try:
        data = json.loads(out) if out else {}
    except json.JSONDecodeError:
        data = {"raw": out}
    if check and (p.returncode != 0 or "error" in data):
        raise HerdrError(data.get("error", {}).get("code", "error"), data.get("error", {}).get("message", out))
    return data.get("result", data)


class HerdrError(Exception):
    def __init__(self, code, msg):
        super().__init__(f"{code}: {msg}")
        self.code = code


MODELS = os.path.join(AGENTS, "models.json")


def _under(path, roots):
    path = os.path.realpath(path)
    return any(path == r or path.startswith(r.rstrip("/") + "/") for r in map(os.path.realpath, roots))


def git_root(cwd):
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() or cwd


def main_repo_root(cwd):
    """For a linked worktree, the main repository's root (Codex applies trust there)."""
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                       capture_output=True, text=True)
    common = r.stdout.strip()
    return os.path.dirname(common) if common.endswith("/.git") else git_root(cwd)


def trusted_by(cwd):
    """Which vendors the user has already trusted this folder (or a parent) for."""
    out = set()
    try:
        projects = json.load(open(os.path.join(HOME, ".claude.json"))).get("projects", {})
        roots = [k for k, v in projects.items() if v.get("hasTrustDialogAccepted")]
        # Claude also asks again for a new repo under a trusted parent, so match the folder or
        # its git root exactly (a trusted parent only covers non-repo subfolders).
        exact = {os.path.realpath(r) for r in roots}
        root = git_root(cwd)
        if os.path.realpath(main_repo_root(cwd)) in exact:  # worktree of a trusted repo
            out.add("claude")
        in_repo = os.path.realpath(root) != os.path.realpath(cwd) or os.path.isdir(os.path.join(cwd, ".git"))
        if os.path.realpath(cwd) in exact or os.path.realpath(root) in exact or (not in_repo and _under(cwd, roots)):
            out.add("claude")
    except (OSError, ValueError):
        pass
    try:
        roots = re.findall(r'^\[projects\."([^"]+)"\]\s*\ntrust_level\s*=\s*"trusted"',
                           open(os.path.join(HOME, ".codex", "config.toml")).read(), re.M)
        # codex keys trust on the git root (or the folder itself); parents do not count
        root = git_root(cwd)
        cands = {os.path.realpath(x) for x in (root, cwd, main_repo_root(cwd))}
        if any(os.path.realpath(r) in cands for r in roots):
            out.add("codex")
    except OSError:
        pass
    return out


def pick(role, tier=None, vendor=None, cwd=None):
    """Random vendor (unless forced) + model for the tier. Returns dict(vendor, model, effort, tier).

    Trust: Claude-trusted folders are usable by both (codex gets a per-session trust override);
    a Codex-only-trusted folder forces codex; untrusted folders stay random and prompt the user.
    """
    cfg = json.load(open(MODELS))
    tier = tier or cfg["default_tier"][role]
    vendors = cfg["vendors"]
    if cwd and trusted_by(cwd) == {"codex"}:
        vendors = ["codex"]
    vendor = vendor or os.environ.get("AGENTCTL_FORCE_VENDOR") or random.choice(vendors)
    m = cfg["tiers"][tier][vendor]
    return {"vendor": vendor, "model": m["model"], "effort": m["effort"], "tier": tier}


def role_text(role, specialty=None):
    """The role prompt, the specialty (if any), and the user's personal context file, if present."""
    text = open(os.path.join(ROLES, f"{role}.md")).read()
    spec = load_specialty(specialty) if specialty else None
    if spec:
        text += f"\n\n# Your specialty: {specialty}\n\n{spec['body']}\n"
    if os.path.exists(CONTEXT):
        text += "\n\n# User context\n\n" + open(CONTEXT).read()
    return text


def role_file(role, specialty=None):
    os.makedirs(BUILD, exist_ok=True)
    path = os.path.join(BUILD, f"{role}{'-' + specialty if specialty else ''}.md")
    with open(path, "w") as f:
        f.write(role_text(role, specialty))
    return path


def extra_dirs():
    return ["--add-dir", MEMDIR] if os.path.isdir(MEMDIR) else []


READ_ONLY_ROLES = ("researcher", "reviewer")  # may only write their own report dir


def read_only_settings(outdir, cwd):
    """Write .build/settings-<agent>.json: base deny rules + no writes to the repo or outside."""
    cfg = json.load(open(SETTINGS))
    perms = cfg.setdefault("permissions", {})
    perms.setdefault("deny", []).extend(setup_denies())
    for d in dict.fromkeys([git_root(cwd), cwd] if cwd else []):
        perms.setdefault("deny", []).append(f"Edit(/{os.path.realpath(d)}/**)")  # //abs/path
    perms["blockWritesOutsideWorkingDirectories"] = True
    os.makedirs(BUILD, exist_ok=True)
    path = os.path.join(BUILD, f"settings-{os.path.basename(outdir)}.json")
    with open(path, "w") as f:
        json.dump(cfg, f, indent=1)
    return path


SETUP_REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", ".."))
# the setup as agents see it through ~/agents symlinks (spaces/ and specialties/ stay writable)
SETUP_PATHS = [SETUP_REPO] + [os.path.join(AGENTS, x) for x in
                              ("bin", "roles", "farm", "models.json", "settings.json", "context.md")]


def setup_denies():
    return [f"Edit(/{p}/**)" if not p.endswith((".json", ".md")) else f"Edit(/{p})" for p in SETUP_PATHS]


def guarded_settings():
    """Base settings plus: no agent may edit the agent setup itself (this repo: agentctl, roles, ...)."""
    cfg = json.load(open(SETTINGS))
    cfg.setdefault("permissions", {}).setdefault("deny", []).extend(setup_denies())
    os.makedirs(BUILD, exist_ok=True)
    path = os.path.join(BUILD, "settings-guarded.json")
    with open(path, "w") as f:
        json.dump(cfg, f, indent=1)
    return path


def agent_args(role, choice, cwd=None, outdir=None, specialty=None):
    read_only = role in READ_ONLY_ROLES
    if choice["vendor"] == "claude":
        a = ["--model", choice["model"], "--effort", choice["effort"], "--permission-mode", "auto",
             "--settings", guarded_settings(), "--append-system-prompt-file", role_file(role, specialty)]
        if read_only:
            # Hard confinement: per-agent settings deny edits to the repo (also covers Bash
            # redirects / tee / file commands) and block tool writes outside the working dirs,
            # so only outdir (an --add-dir) is writable. Verified with claude 2.1.319.
            a[a.index("--settings") + 1] = read_only_settings(outdir, cwd)
            a += ["--add-dir", outdir, "--disallowed-tools", "Edit", "NotebookEdit"]
        else:
            a += ["--add-dir", AGENTS, *extra_dirs()]
        return a
    # codex: --no-daemon so shell commands inherit this pane's env (HERDR_*, AGENT_*);
    # --approve-for-me = automatic approval review (closest to claude auto mode);
    # network on so herdr socket / az / git work inside the workspace-write sandbox.
    trust = []
    if cwd and "claude" in trusted_by(cwd) and "codex" not in trusted_by(cwd):
        # The user already trusted this folder in Claude: mirror it for this session only (not saved).
        root = git_root(cwd)
        # one inline table: codex's -c splits dotted keys and can't address a quoted path key
        paths = dict.fromkeys([main_repo_root(cwd), root, cwd])
        trust = ["-c", "projects={" + ", ".join(f'{json.dumps(x)} = {{ trust_level = "trusted" }}' for x in paths) + "}"]
    # role prompt goes in on the command line: a sandboxed parent cannot write ~/.codex profiles
    instructions = role_text(role, specialty) + ("\n\nYou are read-only: never edit files or apply patches.\n"
                                       if role == "reviewer" else "")
    common = ["--no-daemon", "-c", "developer_instructions=" + json.dumps(instructions), "-m", choice["model"],
              "-c", f'model_reasoning_effort="{choice["effort"]}"',
              "-c", "sandbox_workspace_write.network_access=true",
              "-c", "check_for_update_on_startup=false"]
    if read_only:
        # Hard confinement: the sandbox's writable workspace is ONLY the report dir (-C), /tmp is
        # excluded, and approvals are never granted, so it cannot write the repo or anything else.
        # Reads, network (web search, herdr socket for `agentctl report`) still work.
        # Codex's working root is the agent's own output dir, so that is the only folder to trust.
        trust = ["-c", "projects={" + json.dumps(outdir) + ' = { trust_level = "trusted" } }']
        # also writable: the inbox and this space's registry, so `agentctl report` works
        space_agents = os.path.join(os.path.dirname(os.path.dirname(outdir)), "agents")  # spaces/<wid>/agents
        os.makedirs(INBOX, exist_ok=True)
        os.makedirs(space_agents, exist_ok=True)
        return [*common, *trust, "-s", "workspace-write", "-C", outdir, "-a", "never", "--search",
                "--add-dir", INBOX, "--add-dir", space_agents,
                "-c", "sandbox_workspace_write.exclude_slash_tmp=true",
                "-c", "sandbox_workspace_write.exclude_tmpdir_env_var=true"]
    return [*common, *trust, "--approve-for-me", "--add-dir", AGENTS, *extra_dirs()]


def where(pane_id, with_workspace=True):
    """A human location for a pane: “Workspace” › tab “Tab” › pane “Pane” (never raw IDs like w1:pG)."""
    if not pane_id:
        return "an unknown place"
    pane = herdr("pane", "get", pane_id, check=False).get("pane") or {}
    if not pane:
        return "a pane that is gone"
    tab = (herdr("tab", "get", pane["tab_id"], check=False).get("tab") or {}).get("label") or "?"
    ws = (herdr("workspace", "get", pane["workspace_id"], check=False).get("workspace") or {}).get("label") or "?"
    label = pane.get("label")
    out = f"tab \u201c{tab}\u201d" + (f" \u203a pane \u201c{label}\u201d" if label and label != tab else "")
    return (f"\u201c{ws}\u201d \u203a " + out) if with_workspace else out


def agent_by_name(name):
    for a in herdr("agent", "list")["agents"]:
        if a.get("name") == name:
            return a
    return None


def pane_has_agent(pane_id):
    for p in herdr("pane", "list")["panes"]:
        if p["pane_id"] == pane_id:
            return bool(p.get("agent"))
    return True


def start_agent(name, pane, role, tier=None, vendor=None, cwd=None, outdir=None, timeout_ms=25000,
                specialty=None):
    """Start a random-vendor agent in pane; fall back to the other vendor if launch fails.
    Returns (state, choice): state is 'ready' or 'blocked' (e.g. trust dialog)."""
    first = pick(role, tier, vendor, cwd)
    other = "codex" if first["vendor"] == "claude" else "claude"
    forced = vendor or (cwd and trusted_by(cwd) == {"codex"})
    tries = [first] if forced else [first, pick(role, first["tier"], other)]
    last = None
    for choice in tries:
        for _ in range(15):
            try:
                herdr("agent", "start", name, "--kind", choice["vendor"], "--pane", pane,
                      "--timeout", str(timeout_ms), "--", *agent_args(role, choice, cwd, outdir, specialty))
                return "ready", choice
            except HerdrError as e:
                if e.code == "agent_not_ready":
                    return "blocked", choice
                last = e
                if "not at" in str(e) or "available" in str(e) or "shell" in str(e):
                    time.sleep(1)  # shell still booting
                    continue
                break  # real launch failure: try the other vendor
        log(f"{name}: {choice['vendor']} launch failed: {last}")
        # the failed program may still be in the pane; get back to a shell prompt
        herdr("pane", "send-keys", pane, "ctrl+c", check=False)
        time.sleep(1)
    raise last


def wait_idle(name, timeout_ms):
    try:
        r = herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(timeout_ms))
        return r.get("agent", {}).get("agent_status") in ("idle", "done")
    except HerdrError:
        return False


def space_dir(wid):
    d = os.path.join(SPACES, wid)
    os.makedirs(d, exist_ok=True)
    return d


# ------------------------------------------------------------------ CoS

COS_FIRST = """You are the lead farmer (chief of staff) for herdr space {wid} ("{label}"), started in {cwd}.
Your agent name is {name}. You run on {model}. Your state directory is {sdir}.
Read your role (system prompt). Then, in at most 4 lines: say what you infer this space is for
(from its label, working directory, and git state if any), and ask the user what they want done here."""


def start_cos(wid, wait_trust_ms=900000):
    name = f"{COS_PREFIX}{wid.lower()}"
    if not NAME_RE.match(name):
        raise SystemExit(f"bad workspace id for agent name: {wid}")
    for existing in (name, f"cos-{wid.lower()}"):
        if agent_by_name(existing):
            log(f"{existing} already running")
            return existing
    ws = herdr("workspace", "get", wid)["workspace"]
    panes = [p for p in herdr("pane", "list", "--workspace", wid)["panes"]]
    free = [p for p in panes if not p.get("agent")]
    if not free:
        log(f"{wid}: no free shell pane, not starting CoS")
        return None
    pane = free[0]  # herdr's own order; pane IDs are opaque (w1:p9, w1:pD, ...), never parse them
    sdir = space_dir(wid)
    with open(os.path.join(sdir, "space.json"), "w") as f:
        json.dump({"workspace_id": wid, "label": ws.get("label"), "cwd": pane.get("cwd"),
                   "cos": name, "pane": pane["pane_id"], "started": time.time()}, f, indent=1)
    log(f"{wid}: starting {name} in {pane['pane_id']}")
    if sum(1 for p in panes if p["tab_id"] == pane["tab_id"]) == 1:
        herdr("tab", "rename", pane["tab_id"], COS_LABEL, check=False)
    herdr("pane", "rename", pane["pane_id"], COS_LABEL, check=False)
    state, choice = start_agent(name, pane["pane_id"], "chief-of-staff", cwd=pane.get("cwd"))
    with open(os.path.join(sdir, "space.json"), "r+") as f:
        meta = json.load(f); meta["cos_model"] = choice; f.seek(0); json.dump(meta, f, indent=1); f.truncate()
    log(f"{name}: {choice['vendor']} {choice['model']} ({choice['effort']})")
    reg_update(wid, name, name=name, parent=None, role="chief-of-staff", title=COS_LABEL, pane=pane["pane_id"],
               cwd=pane.get("cwd"), model=choice, started=time.time(), last_report=0, state="running")
    if state == "blocked":
        log(f"{name}: waiting for the user to answer a startup dialog (trust?) in {pane['pane_id']}")
        if not wait_idle(name, wait_trust_ms):
            log(f"{name}: never became ready; leaving it")
            return None
    submit(name, COS_FIRST.format(
        wid=wid, label=ws.get("label"), cwd=pane.get("cwd"), name=name, sdir=sdir,
        model=f"{choice['vendor']} {choice['model']} ({choice['effort']} effort)"))
    log(f"{name}: ready")
    return name


# ------------------------------------------------------------------ spawn

CHILD_HEADER = """You are {name} (role: {role}) in herdr space {wid}. Your parent agent is {parent}.
Report to your parent ONLY with: ~/agents/bin/agentctl report "<message>"
(milestones, when you need a decision, when blocked, when done). A worker, reviewer or
researcher sends its LAST report with --final; its pane then closes (children are single-use).{extra} Your task:

{task}"""

OUTDIR_NOTE = """
You are read-only. The ONLY place you may write is your output directory: {outdir}
Put your report there. The code you are asked about is in {cwd} (read it; do not change it)."""


def my_name():
    if os.environ.get("AGENT_NAME"):
        return os.environ["AGENT_NAME"]
    pane = os.environ.get("HERDR_PANE_ID")
    if pane:
        try:
            a = herdr("agent", "get", pane)["agent"]
            if a.get("name"):
                return a["name"]
        except HerdrError:
            pass
    raise SystemExit("cannot determine my agent name (not in a named herdr agent pane)")


def place_pane(wid, role, slug, title, parent, cwd, env):
    """Open the pane for a new agent and name its tab/pane.

    - lead, or anything the CoS starts: its own tab, labeled with the descriptive title.
    - worker/reviewer started by a lead: a split in the lead's tab (max PANES_PER_TAB), the pane
      labeled with the title; overflow goes to a new tab labeled with the title.
    """
    env_args = [x for k, v in env.items() for x in ("--env", f"{k}={v}")]
    parent_slug = parent.split("-", 1)[1] if parent.startswith(f"{wid.lower()}-") else None
    my_tab = os.environ.get("HERDR_TAB_ID")
    if role != "lead" and parent_slug and my_tab:
        tab_panes = [p for p in herdr("pane", "list", "--workspace", wid)["panes"] if p["tab_id"] == my_tab]
        if len(tab_panes) < PANES_PER_TAB:
            # Herdr pane IDs are opaque handles, not decimal sequence numbers.
            last = tab_panes[-1]
            direction = "right" if len(tab_panes) % 2 == 1 else "down"
            pane = herdr("pane", "split", last["pane_id"], "--direction", direction, "--cwd", cwd,
                         "--no-focus", *env_args)["pane"]["pane_id"]
            herdr("pane", "rename", pane, title, check=False)
            return pane
    label = title
    r = herdr("tab", "create", "--workspace", wid, "--label", label, "--cwd", cwd, "--no-focus", *env_args)
    pane = r["root_pane"]["pane_id"]
    herdr("pane", "rename", pane, title, check=False)
    return pane


def cmd_spawn(a):
    wid = os.environ.get("HERDR_WORKSPACE_ID")
    if not wid:
        raise SystemExit("spawn must run inside a herdr pane")
    parent = my_name()
    slug = re.sub(r"[^a-z0-9_-]", "-", a.slug.lower()).strip("-")
    while slug.startswith(f"{wid.lower()}-"):  # callers sometimes pass the full agent name
        slug = slug[len(wid) + 1:]
    name = f"{wid.lower()}-{slug}"[:32]
    if not NAME_RE.match(name):
        raise SystemExit(f"invalid agent name {name}")
    if agent_by_name(name):
        raise SystemExit(f"agent {name} already exists. Children are single-use: pick a new slug "
                         "(do not send a second task to a finished child)")
    if a.specialty:
        a.specialty = re.sub(r"[^a-z0-9_-]", "-", a.specialty.lower()).strip("-")
        spec = load_specialty(a.specialty)
        if not spec:
            raise SystemExit(f"no specialty {a.specialty!r}: write {SPECIALTIES}/{a.specialty}.md first "
                             "(see `agentctl specialties`)")
        base = spec["meta"].get("role")
        if base and base != a.role:
            raise SystemExit(f"specialty {a.specialty} is defined for role {base}, not {a.role}")
        if a.role == "lead":
            raise SystemExit("specialties are for animals (worker, researcher, reviewer), not farmers")
    task = a.task if a.task != "-" else sys.stdin.read()
    cwd = os.path.abspath(os.path.expanduser(a.cwd or os.getcwd()))
    outdir = None
    if a.role in READ_ONLY_ROLES:
        outdir = os.path.join(space_dir(wid), "research" if a.role == "researcher" else "reviews", name)
        os.makedirs(outdir, exist_ok=True)
    env = {"AGENT_NAME": name, "AGENT_PARENT": parent, "AGENT_ROLE": a.role, "AGENT_SPACE": wid}
    if outdir:
        env["AGENT_OUTDIR"] = outdir
    extra = OUTDIR_NOTE.format(outdir=outdir, cwd=os.path.abspath(os.path.expanduser(a.cwd or os.getcwd()))) if outdir else ""
    title = " ".join(a.title.split())
    if len(title.split()) < 2 or title.lower().replace(" ", "-") == slug:
        raise SystemExit("--title must say what the agent does, in 2+ words "
                         "(e.g. 'review auth token refresh PR'), not just the area")
    if len(title) > TITLE_MAX:
        raise SystemExit(f"--title is {len(title)} chars; keep it to {TITLE_MAX} so the tab label is not cut off "
                         "(verb + object, e.g. 'review auth token refresh PR')")
    pane = place_pane(wid, a.role, slug, title, parent, cwd, env)
    # visible from the start: a spawn that is cut off still leaves a registry entry
    reg_update(wid, name, name=name, parent=parent, role=a.role, title=title, pane=pane, cwd=cwd,
               outdir=outdir, specialty=a.specialty, animal=animal_for(a.role, a.specialty),
               started=time.time(), last_report=0, state="starting")
    pending_file = os.path.join(space_dir(wid), f"pending-task-{name}.md")
    extra = OUTDIR_NOTE.format(outdir=outdir, cwd=cwd) if outdir else ""
    with open(pending_file, "w") as f:  # kept until the task is submitted, for send-pending
        f.write(CHILD_HEADER.format(name=name, role=a.role, wid=wid, parent=parent, task=task, extra=extra))
    try:
        state, choice = start_agent(name, pane, a.role, a.tier, a.vendor, cwd, outdir, specialty=a.specialty)
    except Exception:
        # do not leave a tab with only a terminal behind (it confuses the user and the parent)
        info = herdr("pane", "get", pane, check=False).get("pane") or {}
        tab_panes = [p for p in herdr("pane", "list", "--workspace", wid, check=False).get("panes", [])
                     if p.get("tab_id") == info.get("tab_id")]
        if len(tab_panes) <= 1 and info.get("tab_id"):
            herdr("tab", "close", info["tab_id"], check=False)
        else:
            herdr("pane", "close", pane, check=False)
        raise
    out = {"animal": animal_for(a.role, a.specialty), "specialty": a.specialty, "outdir": outdir, "name": name,
           "title": title, "pane": pane, "role": a.role, "parent": parent, "cwd": cwd,
           "model": choice}
    if state == "blocked":
        screen = herdr("agent", "read", name, "--source", "visible", check=False)
        reg_update(wid, name, name=name, parent=parent, role=a.role, title=title, pane=pane, cwd=cwd,
                   model=choice, outdir=outdir, specialty=a.specialty, animal=animal_for(a.role, a.specialty),
                   started=time.time(), last_report=0, state="pending")
        out.update(status="blocked_at_startup", hint="Likely a folder-trust dialog. Ask the user to answer it in "
                   f"{where(pane)}; then run: agentctl send-pending {name}.",
                   screen=str(screen.get("read", screen))[-800:])
        with open(os.path.join(space_dir(wid), f"pending-task-{name}.md"), "w") as f:
            f.write(CHILD_HEADER.format(name=name, role=a.role, wid=wid, parent=parent, task=task, extra=extra))
        print(json.dumps(out, indent=1))
        sys.exit(3)
    submit(name, open(pending_file).read())
    os.remove(pending_file)
    reg_update(wid, name, name=name, parent=parent, role=a.role, title=title, pane=pane, cwd=cwd,
               model=choice, outdir=outdir, specialty=a.specialty, animal=animal_for(a.role, a.specialty),
               started=time.time(), last_report=0, state="running")
    out["status"] = "started"
    print(json.dumps(out, indent=1))


def cmd_send_pending(a):
    """Deliver a task that was held because the child was blocked at startup."""
    wid = os.environ.get("HERDR_WORKSPACE_ID") or (agent_by_name(a.name) or {}).get("workspace_id") or a.name.split("-")[0]
    path = os.path.join(space_dir(wid), f"pending-task-{a.name}.md")
    if not wait_idle(a.name, 5000):
        raise SystemExit(f"{a.name} is not idle yet (still blocked?)")
    submit(a.name, open(path).read())
    os.remove(path)
    reg_update(wid, a.name, state="running")
    print(json.dumps({"name": a.name, "status": "task_sent"}))


def cmd_report(a):
    parent, me = os.environ.get("AGENT_PARENT"), os.environ.get("AGENT_NAME", "?")
    if a.as_name:  # adopted agent naming itself (its shell may not carry this pane's env)
        entry = next((e for e in reg_all() if e.get("name") == a.as_name and e.get("state") == "running"), None)
        if not entry:
            raise SystemExit(f"no running registered agent named {a.as_name}")
        parent, me = entry.get("parent"), entry["name"]
        os.environ["AGENT_SPACE"] = entry["workspace_id"]
    elif not parent and os.environ.get("HERDR_PANE_ID"):  # adopted agent: find it by pane
        entry = next((e for e in reg_all() if e.get("pane") == os.environ["HERDR_PANE_ID"]
                      and e.get("state") == "running"), None)
        if entry:
            parent, me = entry.get("parent"), entry["name"]
            os.environ.setdefault("AGENT_SPACE", entry["workspace_id"])
    if not parent:
        raise SystemExit("no parent: not a spawned or adopted agent (AGENT_PARENT unset, pane not registered)")
    text = a.text if a.text != "-" else sys.stdin.read()
    space = os.environ.get("AGENT_SPACE")
    where = enqueue(parent, f"[from {me}]{' [final]' if a.final else ''} {text}", me,
                    final=a.final, space=space)
    if space and me != "?":
        try:
            reg_update(space, me, last_report=time.time(), last_report_text=text[:600])
        except OSError:
            pass  # sandboxed: the watcher records the report when it delivers it
    print(json.dumps({"queued_for": parent, "via": where,
                      "note": "delivered when the parent has no draft in its input box"
                              + ("; your pane closes after delivery" if a.final else "")}))


# ------------------------------------------------------------------ decisions (structured "Needs you")

def decisions_path(wid):
    return os.path.join(space_dir(wid), "decisions.json")


def load_decisions(wid):
    try:
        return json.load(open(decisions_path(wid)))
    except (OSError, ValueError):
        return {"next": 1, "items": []}


def save_decisions(wid, d):
    tmp = decisions_path(wid) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=1)
    os.replace(tmp, decisions_path(wid))
    open_items = [i for i in d["items"] if i["status"] == "open"]
    # show the count in herdr's sidebar on the lead farmer's pane
    lf = agent_by_name(cos_name(wid))
    if lf:
        title = f"{COS_LABEL} · needs you: {len(open_items)}" if open_items else f"{COS_LABEL} · all clear"
        herdr("pane", "report-metadata", lf["pane_id"], "--source", "agentctl-decisions", "--title", title,
              "--seq", str(time.time_ns()), check=False)


def _space_from_env():
    wid = os.environ.get("HERDR_WORKSPACE_ID") or os.environ.get("AGENT_SPACE")
    if not wid:
        raise SystemExit("run inside a herdr pane (HERDR_WORKSPACE_ID unset)")
    return wid


def format_decisions(items):
    order = {"P1": 0, "P2": 1, "P3": 2}
    items = sorted(items, key=lambda i: (order.get(i["priority"], 9), i["created"]))
    if not items:
        return "Nothing needs you."
    lines = ["Needs you:"]
    for i in items:
        lines.append(f" {i['id']} {i['priority']} {i['lead']}: {i['question']}")
        lines.append(f"    rec: {i['rec']}   default: {i['default']}" + (f"   ({i['evidence']})" if i.get("evidence") else ""))
    return "\n".join(lines)


def cmd_ask(a):
    """The lead farmer records a decision for the user; agentctl assigns the ID and raises the alert."""
    wid = _space_from_env()
    d = load_decisions(wid)
    item = {"id": f"D{d['next']}", "priority": a.priority, "lead": a.lead, "question": a.question,
            "rec": a.rec, "default": a.default, "evidence": a.evidence, "created": time.time(), "status": "open"}
    d["next"] += 1
    d["items"].append(item)
    save_decisions(wid, d)
    label = (herdr("workspace", "get", wid, check=False).get("workspace") or {}).get("label") or wid
    herdr("notification", "show", f"Lead farmer · {label}: needs you",
          "--body", f"{item['id']} {item['priority']} {item['lead']}: {item['question']}"[:300],
          "--sound", "request", check=False)
    print(json.dumps(item))


def cmd_resolve(a):
    wid = _space_from_env()
    d = load_decisions(wid)
    for i in d["items"]:
        if i["id"].lower() == a.id.lower() and i["status"] == "open":
            i.update(status="withdrawn" if a.withdraw else "answered", answer=a.answer, resolved=time.time())
            save_decisions(wid, d)
            print(json.dumps(i))
            return
    raise SystemExit(f"no open decision {a.id}")


def cmd_decisions(a):
    wid = _space_from_env()
    items = load_decisions(wid)["items"]
    if a.all:
        print(json.dumps(items, indent=1))
    else:
        print(format_decisions([i for i in items if i["status"] == "open"]))


def cmd_needs_you(a):
    """CoS: raise a herdr alert (request sound) that the user must decide something."""
    wid = os.environ.get("HERDR_WORKSPACE_ID")
    label = wid or "?"
    if wid:
        try:
            label = herdr("workspace", "get", wid)["workspace"].get("label") or wid
        except HerdrError:
            pass
    text = a.text if a.text != "-" else sys.stdin.read()
    r = herdr("notification", "show", f"Lead farmer · {label}: needs you", "--body", text[:300],
              "--sound", "request", check=False)
    print(json.dumps({"shown": r.get("shown"), "reason": r.get("reason")}))


def cmd_adopt(a):
    """Make an agent the user started by hand a lead under this space's chief of staff."""
    wid = a.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    pane = herdr("pane", "get", a.pane)["pane"]
    wid = wid or pane["workspace_id"]
    vendor = pane.get("agent")
    if vendor not in ("claude", "codex"):
        raise SystemExit(f"pane {a.pane} runs {vendor!r}; only claude and codex can be adopted")
    cos = cos_name(wid)
    slug = re.sub(r"[^a-z0-9_-]", "-", a.slug.lower()).strip("-")
    name = f"{wid.lower()}-{slug}"[:32]
    title = " ".join(a.title.split())
    if len(title.split()) < 2 or len(title) > TITLE_MAX:
        raise SystemExit(f"--title must be 2+ words and at most {TITLE_MAX} chars")
    # the launch options the user chose, read from the running process (minus resume/session words)
    launch_args = []
    pids = subprocess.run(["pgrep", "-x", vendor], capture_output=True, text=True).stdout.split()
    for pid in pids:
        try:
            if os.readlink(f"/proc/{pid}/cwd") != (pane.get("foreground_cwd") or pane.get("cwd")):
                continue
            argv = open(f"/proc/{pid}/cmdline").read().split("\0")[1:-1]
        except OSError:
            continue
        if argv and argv[0] in ("app-server",):
            continue
        launch_args = [x for x in argv if x not in ("resume",)]
        break
    herdr("agent", "rename", a.pane, name)
    tab = pane["tab_id"]
    herdr("tab", "rename", tab, title, check=False)
    herdr("pane", "rename", a.pane, title, check=False)
    reg_update(wid, name, name=name, parent=cos, role="lead", title=title, pane=a.pane,
               cwd=pane.get("foreground_cwd") or pane.get("cwd"),
               model={"vendor": vendor, "model": "user-default", "effort": "user-default", "tier": "adopted"},
               launch_args=launch_args, adopted=True, started=time.time(), last_report=time.time(),
               state="running")
    print(json.dumps({"name": name, "parent": cos, "pane": a.pane, "tab": tab, "title": title,
                      "launch_args": launch_args}, indent=1))


def cmd_resume(a):
    """Run by herdr after a server restart (the reported resume command): relaunch the agent with the
    same vendor, model, role prompt, settings and environment, resuming its native session."""
    entry = next((e for e in reg_all() if e.get("name") == a.name), None)
    if not entry:  # unknown agent: fall back to what the official integration would have run
        log(f"resume {a.name}: not in registry; plain resume")
        os.execvp("claude", ["claude", "--resume", a.session_id])
    wid, role, choice = entry["workspace_id"], entry["role"], entry["model"]
    cwd = entry.get("cwd") or os.getcwd()
    outdir = entry.get("outdir")
    env = {"AGENT_NAME": a.name, "AGENT_ROLE": role, "AGENT_SPACE": wid}
    if entry.get("parent"):
        env["AGENT_PARENT"] = entry["parent"]
    if outdir:
        env["AGENT_OUTDIR"] = outdir
    os.environ.update(env)
    if os.environ.get("HERDR_PANE_ID"):
        reg_update(wid, a.name, pane=os.environ["HERDR_PANE_ID"], resumed=time.time())
    # adopted agents (started by hand, see `adopt`) keep their own launch options
    args = entry["launch_args"] if entry.get("launch_args") is not None else agent_args(role, choice, cwd, outdir,
                                                                                         entry.get("specialty"))
    if choice["vendor"] == "claude":
        argv = ["claude", "--resume", a.session_id, *args]
    else:
        argv = ["codex", "resume", a.session_id, *args]
    log(f"resume {a.name}: {choice['vendor']} {choice['model']} session {a.session_id[:8]}")
    os.execvp(argv[0], argv)


# ------------------------------------------------------------------ the farm (live web view)

def _farm_agent(live, reg, kind):
    m = reg.get("model") or {}
    return {"name": live.get("name") or live.get("pane_id"), "kind": kind,
            "status": live.get("agent_status", "unknown"), "title": reg.get("title"),
            "vendor": m.get("vendor") or live.get("agent"), "model": m.get("model"), "effort": m.get("effort"),
            "tier": m.get("tier"), "context_tokens": reg.get("context_tokens"),
            "context_window": reg.get("context_window"), "compactions": reg.get("compactions", 0),
            "last_report": reg.get("last_report"), "last_report_text": reg.get("last_report_text"),
            "parent": reg.get("parent"), "pane": live.get("pane_id"), "cwd": live.get("cwd") or reg.get("cwd"),
            "tab": live.get("tab_id"), "started": reg.get("started")}


def farm_state():
    agents = herdr("agent", "list")["agents"]
    reg = {e["name"]: e for e in reg_all() if e.get("name")}
    inbox_counts = {}
    if os.path.isdir(INBOX):
        for fn in os.listdir(INBOX):
            if fn.endswith(".jsonl"):
                try:
                    inbox_counts[fn[:-6]] = sum(1 for l in open(os.path.join(INBOX, fn)) if l.strip())
                except OSError:
                    pass
    spaces = []
    for w in herdr("workspace", "list")["workspaces"]:
        wid = w["workspace_id"]
        here = [a for a in agents if a["workspace_id"] == wid]
        lf_names = {cos_name(wid), f"cos-{wid.lower()}", f"{COS_PREFIX}{wid.lower()}"}
        lead_farmer, farmers, loose = None, [], []
        for a in here:
            r = reg.get(a.get("name") or "", {})
            if a.get("name") in lf_names:
                lead_farmer = _farm_agent(a, r | {"title": COS_LABEL}, "leadfarmer")
            elif r.get("role") == "lead":
                farmers.append(_farm_agent(a, r, "farmer") | {"animals": []})
        by_name = {f["name"]: f for f in farmers}
        for a in here:
            r = reg.get(a.get("name") or "", {})
            if a.get("name") in lf_names or r.get("role") == "lead":
                continue
            if r.get("role") in ANIMALS:
                animal = _farm_agent(a, r, r.get("animal") or ANIMALS[r["role"]]) | {
                    "specialty": r.get("specialty"), "role": r.get("role")}
                (by_name[r["parent"]]["animals"] if r.get("parent") in by_name else loose).append(animal)
            else:
                loose.append(_farm_agent(a, r, "farmhand"))
        try:
            cwd = json.load(open(os.path.join(SPACES, wid, "space.json"))).get("cwd")
        except (OSError, ValueError):
            cwd = None
        open_decisions = [i for i in load_decisions(wid)["items"] if i["status"] == "open"] \
            if os.path.isdir(os.path.join(SPACES, wid)) else []
        tabs = {t["tab_id"]: t["label"] for t in herdr("tab", "list", "--workspace", wid, check=False).get("tabs", [])}
        needs = []
        for d in open_decisions:
            needs.append({"kind": "decision", "id": d["id"], "priority": d["priority"], "text": d["question"],
                          "detail": f"rec: {d['rec']} · default: {d['default']}", "from": d["lead"],
                          "since": d["created"], "focus": cos_name(wid)})
        for a in here:
            nm = a.get("name") or a["pane_id"]
            if a["agent_status"] == "blocked":
                needs.append({"kind": "dialog", "priority": "P1", "id": nm,
                              "text": f"Waiting on a dialog in {where(a['pane_id'], with_workspace=False)}",
                              "detail": screen_tail(nm, 3) if a.get("name") else "", "from": nm,
                              "since": None, "focus": nm})
            held = inbox_counts.get(a.get("name") or "", 0)
            if held and a.get("name") and has_draft(a["name"]):
                needs.append({"kind": "draft", "priority": "P2", "id": nm,
                              "text": f"Your unsent draft in {where(a['pane_id'], with_workspace=False)} is holding "
                                      f"{held} message(s) for {nm}", "detail": "Send or clear the draft to let them in.",
                              "from": nm, "since": None, "focus": nm})
        meta_cos = None
        try:
            meta_cos = json.load(open(os.path.join(SPACES, wid, "space.json"))).get("cos")
        except (OSError, ValueError):
            pass
        if meta_cos and not lead_farmer:
            needs.append({"kind": "down", "priority": "P1", "id": meta_cos,
                          "text": f"The lead farmer of this field ({meta_cos}) is not running",
                          "detail": f"Restart it: agentctl start-cos {wid}", "from": "watcher", "since": None,
                          "focus": None})
        for a in [lead_farmer, *farmers, *loose, *[x for f in farmers for x in f["animals"]]]:
            if a:
                a["waiting"] = inbox_counts.get(a["name"], 0)
        for a in [lead_farmer, *farmers, *loose]:
            if a:
                a["tab_label"] = tabs.get(a.get("tab"))
                a["where"] = where(a.get("pane"))
        for f in farmers:
            for x in f["animals"]:
                x["tab_label"] = tabs.get(x.get("tab"))
                x["where"] = where(x.get("pane"))
        spaces.append({"id": wid, "label": w.get("label") or wid, "cwd": cwd, "lead_farmer": lead_farmer,
                       "decisions": open_decisions, "needs": needs,
                       "farmers": farmers, "loose": loose,
                       "waiting_messages": sum(inbox_counts.get(a.get("name") or "", 0) for a in here)})
    return {"generated": time.time(), "spaces": spaces}


AGENT_PREFIXES = ("[inbox]", "[from ", "[watch]", "\U0001F4EC", "You are the lead farmer", "You are the chief of staff",
                  "Your context was reset", "Setup update", "/compact", "/clear", "/new", "<environment_context")


def _human_text(t):
    t = re.sub(r"^\s*<pasted_content[^>]*>\s*|\s*</pasted_content[^>]*>\s*$", "", t or "").strip()
    if not t or t.startswith(AGENT_PREFIXES):
        return None
    # an old report that landed in the middle of the user's typing: keep only the user's part
    cut = min([i for i in (t.find(" " + p) for p in ("[from ", "[watch]", "[inbox]")) if i > 0] or [len(t)])
    return t[:cut].strip() or None


def _ts(iso):
    from datetime import datetime
    try:
        return datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError):
        return None


def _describe_tool(name, inp):
    base = lambda pth: os.path.basename(str(pth or "").rstrip("/")) or str(pth)  # noqa: E731
    if isinstance(inp, str):  # codex: tools.exec_command({cmd:"..."}) / tools.apply_patch("*** Update File: x")
        m = re.search(r'cmd:\s*"((?:[^"\\]|\\.)*)"', inp)
        if m:
            return "Running: " + m.group(1).encode().decode("unicode_escape", "ignore").splitlines()[0][:150]
        m = re.search(r"\*\*\* (?:Update|Add|Delete) File: ([^\\\n]+)", inp)
        if m:
            return "Editing: " + base(m.group(1).strip())
        return f"Using {name}"
    inp = inp or {}
    if name == "Bash":
        return "Running: " + str(inp.get("command", "")).splitlines()[0][:150] if inp.get("command") else "Running a command"
    if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        return "Editing: " + base(inp.get("file_path") or inp.get("notebook_path"))
    if name == "Read":
        return "Reading: " + base(inp.get("file_path"))
    if name in ("Grep", "Glob"):
        return f"Searching: {inp.get('pattern', '')}"[:150]
    if name in ("WebFetch", "WebSearch"):
        return f"Web: {inp.get('url') or inp.get('query', '')}"[:150]
    if name in ("Agent", "Task"):
        return f"Delegating: {inp.get('description', '')}"[:150]
    return f"Using {name}"


def activity(vendor, session_id):
    """What the agent is doing now: its latest tool call or note, from its transcript."""
    import glob
    if not session_id:
        return None
    pat = (os.path.join(HOME, ".claude", "projects", "*", f"{session_id}.jsonl") if vendor == "claude" else
           os.path.join(HOME, ".codex", "sessions", "*", "*", "*", f"*{session_id}*.jsonl"))
    files = glob.glob(pat)
    if not files:
        return None
    for line in reversed(_tail_lines(files[0], 1_500_000)):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if vendor == "claude" and d.get("type") == "assistant":
            for x in reversed(d["message"]["content"]):
                if x.get("type") == "tool_use":
                    return {"text": _describe_tool(x.get("name"), x.get("input")), "ts": _ts(d.get("timestamp"))}
                if x.get("type") == "text" and x.get("text", "").strip():
                    return {"text": x["text"].strip().splitlines()[0][:200], "ts": _ts(d.get("timestamp"))}
        if vendor != "claude" and d.get("type") == "response_item":
            p = d.get("payload") or {}
            if p.get("type") in ("custom_tool_call", "function_call"):
                return {"text": _describe_tool(p.get("name"), p.get("input") or p.get("arguments")),
                        "ts": _ts(d.get("timestamp"))}
            if p.get("type") == "message" and p.get("role") == "assistant":
                t = "\n".join(c.get("text", "") for c in p.get("content", []) if isinstance(c, dict)).strip()
                if t:
                    return {"text": t.splitlines()[0][:200], "ts": _ts(d.get("timestamp"))}
    return None


def message_history(vendor, session_id, name, parent, limit=60):
    """Everything said to and by a farmer or animal, labeled: task, parent, you, watchdog, children,
    its reports, and its replies. Tool calls are left out."""
    import glob
    out = []
    farm_sent = set()
    try:
        farm_sent = {json.loads(l)["text"].strip() for l in open(os.path.join(INBOX, f"{name}.farm.jsonl"))}
    except (OSError, ValueError):
        pass
    if session_id:
        pat = (os.path.join(HOME, ".claude", "projects", "*", f"{session_id}.jsonl") if vendor == "claude" else
               os.path.join(HOME, ".codex", "sessions", "*", "*", "*", f"*{session_id}*.jsonl"))
        files = glob.glob(pat)
        for line in _tail_lines(files[0], 8_000_000) if files else []:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            ts = _ts(d.get("timestamp"))
            if vendor == "claude":
                if d.get("type") == "user" and not d.get("isMeta"):
                    c = d["message"]["content"]
                    texts = [c] if isinstance(c, str) else [x.get("text", "") for x in c if x.get("type") == "text"]
                    if texts and texts[0].strip():
                        out.append(_classify_in(texts[0], name, parent, farm_sent, ts))
                elif d.get("type") == "assistant" and d["message"].get("stop_reason") == "end_turn":
                    t = "\n".join(x.get("text", "") for x in d["message"]["content"] if x.get("type") == "text").strip()
                    if t:
                        out.append({"kind": "reply", "from": name, "text": t, "ts": ts})
            else:
                p = d.get("payload") or {}
                if d.get("type") != "response_item" or p.get("type") != "message":
                    continue
                t = "\n".join(c.get("text", "") for c in p.get("content", []) if isinstance(c, dict)).strip()
                if p.get("role") == "user" and t and not t.startswith("<environment_context"):
                    out.append(_classify_in(t, name, parent, farm_sent, ts))
                elif p.get("role") == "assistant" and p.get("phase") == "final_answer" and t:
                    out.append({"kind": "reply", "from": name, "text": t, "ts": ts})
    try:
        for l in open(os.path.join(INBOX, f"{name}.sent.jsonl")):
            m = json.loads(l)
            out.append({"kind": "report", "from": name, "to": m.get("to"), "text": m["text"], "ts": m["ts"]})
    except (OSError, ValueError):
        pass
    out = [m for m in out if m]
    out.sort(key=lambda m: m.get("ts") or 0)
    return out[-limit:]


def _classify_in(raw, name, parent, farm_sent, ts):
    t = re.sub(r"^\s*<pasted_content[^>]*>\s*|\s*</pasted_content[^>]*>\s*$", "", raw).strip()
    if t.strip() in farm_sent:
        kind, who = "you", "you"
    elif t.startswith(f"You are {name} ("):
        kind, who = "task", parent or "parent"
    elif t.startswith("[watch]"):
        kind, who = "watch", "watchdog"
    elif t.startswith(("[from ", "[inbox]", "\U0001F4EC")):
        kind, who = "children", "its animals"
    elif t.startswith(("/compact", "/clear", "/new", "Your context was reset")):
        return None
    else:
        kind, who = "parent", parent or "parent"
    return {"kind": kind, "from": who, "text": t, "ts": ts}


def _reply_text(t):
    t = re.sub(r"\s*Nothing needs you\.?\s*$", "", (t or "").strip())
    return t.strip()


def conversation(vendor, session_id, limit=40):
    """Only the user's messages to this agent and its replies to them (no reports, notes, or tools)."""
    import glob
    out = []
    if not session_id:
        return out
    try:
        if vendor == "claude":
            files = glob.glob(os.path.join(HOME, ".claude", "projects", "*", f"{session_id}.jsonl"))
            human_turn = False
            for line in _tail_lines(files[0], 8_000_000) if files else []:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") == "user" and not d.get("isMeta"):
                    c = d["message"]["content"]
                    texts = [c] if isinstance(c, str) else [x.get("text", "") for x in c if x.get("type") == "text"]
                    if texts:
                        t = _human_text(texts[0])
                        human_turn = human_turn or t is not None  # queued messages can share one turn
                        if t:
                            out.append({"from": "you", "text": t, "ts": d.get("timestamp")})
                elif d.get("type") == "assistant" and d["message"].get("stop_reason") == "end_turn":
                    t = "\n".join(x.get("text", "") for x in d["message"]["content"] if x.get("type") == "text")
                    if human_turn and _reply_text(t):
                        out.append({"from": "lead farmer", "text": _reply_text(t), "ts": d.get("timestamp")})
                    human_turn = False
        else:
            files = glob.glob(os.path.join(HOME, ".codex", "sessions", "*", "*", "*", f"*{session_id}*.jsonl"))
            human_turn = False
            for line in _tail_lines(files[0], 8_000_000) if files else []:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                p = d.get("payload") or {}
                if d.get("type") != "response_item" or p.get("type") != "message":
                    continue
                t = "\n".join(c.get("text", "") for c in p.get("content", []) if isinstance(c, dict))
                if p.get("role") == "user":
                    h = _human_text(t)
                    human_turn = human_turn or h is not None  # queued messages can share one turn
                    if h:
                        out.append({"from": "you", "text": h, "ts": d.get("timestamp")})
                elif p.get("role") == "assistant" and p.get("phase") == "final_answer":
                    if human_turn and _reply_text(t):
                        out.append({"from": "lead farmer", "text": _reply_text(t), "ts": d.get("timestamp")})
                    human_turn = False
    except (OSError, ValueError, KeyError, IndexError):
        pass
    return out[-limit:]


_FARM_CACHE = {"t": 0, "data": None}
_FARM_LOCK = threading.Lock()


def cached_farm_state(max_age=2.0):
    with _FARM_LOCK:
        if not _FARM_CACHE["data"] or time.time() - _FARM_CACHE["t"] > max_age:
            _FARM_CACHE["data"], _FARM_CACHE["t"] = farm_state(), time.time()
        return _FARM_CACHE["data"]


def farm_agent_detail(name):
    for space in cached_farm_state(3.0)["spaces"]:
        for a in [space["lead_farmer"], *space["farmers"], *[x for f in space["farmers"] for x in f["animals"]],
                  *space["loose"]]:
            if a and a["name"] == name:
                r = herdr("agent", "read", name, "--source", "visible", check=False)
                lines = [l.rstrip() for l in str(r.get("raw", "")).splitlines()]
                while lines and not lines[-1]:
                    lines.pop()
                extra = {}
                live = agent_by_name(name)
                if live:
                    extra["status"] = live["agent_status"]
                e = next((x for x in reg_all() if x.get("name") == name), {})
                vendor = (e.get("model") or {}).get("vendor") or a.get("vendor")
                extra["activity"] = activity(vendor, e.get("session_id"))
                if a["kind"] != "leadfarmer":
                    extra["messages"] = message_history(vendor, e.get("session_id"), name, e.get("parent"))
                if a["kind"] == "leadfarmer":
                    e = next((x for x in reg_all() if x.get("name") == name), {})
                    extra["conversation"] = conversation((e.get("model") or {}).get("vendor") or a.get("vendor"),
                                                         e.get("session_id"))
                    unread = os.path.join(INBOX, f"{name}.unread")
                    extra["unread_reports"] = sum(1 for l in open(unread) if l.strip()) if os.path.exists(unread) else 0
                return dict(a, screen="\n".join(lines[-45:]), **extra)
    return {"name": name, "kind": "?", "status": "gone", "screen": "This agent is no longer on the farm."}


PROXY_URL = os.environ.get("AGENTCTL_PROXY_URL", "http://localhost:4141")


def copilot_quota():
    """Premium-credit quota from the copilot-api proxy's /usage (only the quota numbers)."""
    import urllib.request
    from datetime import datetime, timezone
    try:
        with urllib.request.urlopen(f"{PROXY_URL}/usage", timeout=8) as r:
            d = json.load(r)
    except Exception as err:  # noqa: BLE001
        return {"available": False, "error": str(err)[:200]}
    q = (d.get("quota_snapshots") or {}).get("premium_interactions") or {}
    if not q or q.get("unlimited"):
        return {"available": bool(q), "unlimited": bool(q.get("unlimited"))}
    ent = q.get("entitlement") or 0
    used = q.get("credits_used", ent - (q.get("remaining") or 0))
    reset = d.get("quota_reset_date_utc") or d.get("quota_reset_date")
    pace = None
    try:
        end = datetime.fromisoformat(reset.replace("Z", "+00:00"))
        start = end.replace(month=end.month - 1) if end.month > 1 else end.replace(year=end.year - 1, month=12)
        now = datetime.now(timezone.utc)
        pace = max(0.0, min(1.0, (now - start) / (end - start)))
    except Exception:  # noqa: BLE001
        pass
    return {"available": True, "unlimited": False, "used": used, "entitlement": ent,
            "remaining": q.get("remaining"), "percent_used": round(100 * used / ent, 1) if ent else None,
            "reset": reset, "month_elapsed": round(100 * pace, 1) if pace is not None else None,
            "overage_permitted": q.get("overage_permitted"), "overage_count": q.get("overage_count", 0)}


def folder_suggestions():
    """Folders worth offering for a new farm: existing farms' folders and folders Claude/Codex trust."""
    out = []
    for wid in os.listdir(SPACES) if os.path.isdir(SPACES) else []:
        try:
            c = json.load(open(os.path.join(SPACES, wid, "space.json"))).get("cwd")
            if c:
                out.append(c)
        except (OSError, ValueError):
            pass
    try:
        out += [k for k, v in json.load(open(os.path.join(HOME, ".claude.json"))).get("projects", {}).items()
                if v.get("hasTrustDialogAccepted")]
    except (OSError, ValueError):
        pass
    try:
        out += re.findall(r'^\[projects\."([^"]+)"\]', open(os.path.join(HOME, ".codex", "config.toml")).read(), re.M)
    except OSError:
        pass
    return sorted({p for p in out if os.path.isdir(p)})


def create_farm(label, cwd, first_message=None, focus=False):
    """Create a herdr workspace (a farm). The watcher starts its lead farmer; an optional first message
    is delivered once that lead farmer has finished its greeting."""
    label = " ".join((label or "").split())[:60]
    cwd = os.path.realpath(os.path.expanduser((cwd or "").strip() or HOME))
    if not label:
        return {"ok": False, "reason": "give the farm a name"}
    if not os.path.isdir(cwd):
        return {"ok": False, "reason": f"no such folder: {cwd}"}
    args = ["workspace", "create", "--label", label, "--cwd", cwd, "--focus" if focus else "--no-focus"]
    r = herdr(*args, check=False)
    ws = (r.get("workspace") or {})
    wid = ws.get("workspace_id")
    if not wid:
        return {"ok": False, "reason": f"herdr could not create it: {r.get('error') or r}"}
    if first_message and first_message.strip():
        def deliver_first():
            name = f"{COS_PREFIX}{wid.lower()}"
            for _ in range(90):  # wait for the watcher to start the lead farmer
                if agent_by_name(name):
                    break
                time.sleep(2)
            time.sleep(5)
            try:
                herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", "300000", check=False)
                if submit(name, first_message.strip()[:8000]):
                    with open(os.path.join(INBOX, f"{name}.farm.jsonl"), "a") as f:
                        f.write(json.dumps({"ts": time.time(), "text": first_message.strip()[:8000]}) + "\n")
            except Exception as err:  # noqa: BLE001
                log(f"farm {wid}: first message failed: {err}")
        threading.Thread(target=deliver_first, daemon=True).start()
    return {"ok": True, "workspace_id": wid, "label": label, "cwd": cwd}


def cmd_farm(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import unquote
    page = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "farm", "index.html")
    token = os.urandom(16).hex()  # embedded in the page; other sites cannot read it, so cannot POST
    cache = {"t": 0, "body": b"", "qt": 0, "quota": b""}
    lock = threading.Lock()

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            try:
                if self.path in ("/", "/index.html"):
                    html = open(page, encoding="utf-8").read().replace("__FARM_TOKEN__", token) \
                        .replace("__FARM_VERSION__", str(int(os.path.getmtime(page))))
                    self._send(200, html.encode(), "text/html; charset=utf-8")
                elif self.path == "/api/farm":
                    st = dict(cached_farm_state(2.0))
                    st["page_version"] = str(int(os.path.getmtime(page)))  # open pages reload on change
                    body = json.dumps(st).encode()
                    self._send(200, body, "application/json")
                elif self.path == "/api/folders":
                    self._send(200, json.dumps(folder_suggestions()).encode(), "application/json")
                elif self.path == "/api/quota":
                    with lock:
                        if time.time() - cache["qt"] > 60:
                            cache["quota"], cache["qt"] = json.dumps(copilot_quota()).encode(), time.time()
                        body = cache["quota"]
                    self._send(200, body, "application/json")
                elif self.path.startswith("/api/agent/"):
                    name = unquote(self.path[len("/api/agent/"):])
                    self._send(200, json.dumps(farm_agent_detail(name)).encode(), "application/json")
                else:
                    self._send(404, b"not found", "text/plain")
            except Exception as err:  # noqa: BLE001
                self._send(500, json.dumps({"error": str(err)}).encode(), "application/json")

        def do_POST(self):
            if self.headers.get("X-Farm-Token") != token:
                self._send(403, b"forbidden", "text/plain")
                return
            if self.path == "/api/farms":
                n = int(self.headers.get("Content-Length") or 0)
                try:
                    body = json.loads(self.rfile.read(n) or b"{}")
                except ValueError:
                    body = {}
                res = create_farm(body.get("label"), body.get("cwd"), body.get("first_message"), bool(body.get("focus")))
                with _FARM_LOCK:
                    _FARM_CACHE["t"] = 0  # show the new farm right away
                self._send(200 if res["ok"] else 400, json.dumps(res).encode(), "application/json")
                return
            if self.path.startswith("/api/say/"):
                target = unquote(self.path[len("/api/say/"):])
                n = int(self.headers.get("Content-Length") or 0)
                try:
                    text = (json.loads(self.rfile.read(n) or b"{}").get("text") or "").strip()
                except ValueError:
                    text = ""
                live = agent_by_name(target)
                if not text:
                    reason = "empty message"
                elif not live:
                    reason = f"{target} is not running"
                elif live["agent_status"] == "blocked":
                    reason = "it is waiting on a dialog; answer that in its pane first"
                elif has_draft(target):
                    reason = "you have unsent text in its terminal input; send or clear that first"
                else:
                    reason = None
                if reason:
                    self._send(409, json.dumps({"ok": False, "reason": reason}).encode(), "application/json")
                    return
                ok = submit(target, text[:8000])
                if ok:
                    with open(os.path.join(INBOX, f"{target}.farm.jsonl"), "a") as f:
                        f.write(json.dumps({"ts": time.time(), "text": text[:8000]}) + "\n")
                self._send(200 if ok else 500, json.dumps({"ok": ok, "reason": None if ok else
                                                           "the text did not submit"}).encode(), "application/json")
                return
            if self.path.startswith("/api/focus/"):
                target = unquote(self.path[len("/api/focus/"):])
                r = herdr("agent", "focus", target, check=False)
                ok = "error" not in r
                self._send(200 if ok else 404, json.dumps({"ok": ok}).encode(), "application/json")
            else:
                self._send(404, b"not found", "text/plain")

    srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)
    log(f"the farm is open at http://127.0.0.1:{a.port}")
    srv.serve_forever()


